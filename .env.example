NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_flow

REDIS_URL=redis://localhost:6379
# TTL do cache de produto em milissegundos (padrão: 5 minutos)
# PRODUCT_CACHE_TTL_MS=300000

# Optional: debug | info | warn | error
LOG_LEVEL=debug

# Comma-separated origins; omit to allow all (development)
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173
