NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_flow

REDIS_URL=redis://localhost:6379
# TTLs de cache em milissegundos (item: 5 min; listagem: 2 min)
# PRODUCT_CACHE_TTL_MS=300000
# PRODUCT_LIST_CACHE_TTL_MS=120000
# ORDER_CACHE_TTL_MS=300000
# ORDER_LIST_CACHE_TTL_MS=120000

# Optional: debug | info | warn | error
LOG_LEVEL=debug

# Comma-separated origins; omit to allow all (development)
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173
